# metasprint-autopilot — environment template
#
# Copy this file to `.env` and fill in real values before running.
# Never commit your .env (it is gitignored).

# AACT auth token if using token-based access
AACT_AUTH_TOKEN=

# AACT password (paired with AACT_USER above)
AACT_PASSWORD=

# AACT username (free signup at https://aact.ctti-clinicaltrials.org/users/sign_up)
AACT_USER=

# Same as NCBI E-utilities API key
PUBMED_API_KEY=

# Optional integer cap for validation search size
RAPIDMETA_VALIDATION_SEARCH_CAP=

# Optional integer cap for topics in validation
RAPIDMETA_VALIDATION_TOPIC_LIMIT=
